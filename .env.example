# Copie para .env e preencha. Nunca publique o .env.

# Conta DEMO da Quotex (o bot só lê candles, não opera)
QUOTEX_EMAIL=seu-email-da-quotex
QUOTEX_PASSWORD=sua-senha-da-quotex
QUOTEX_HOST=quotex.com
# Opcional: a Quotex (Cloudflare) bloqueia IPs de servidor como o Railway. Lista de proxies
# separados por vírgula, no formato ip:porta:usuario:senha. O bot testa um por um até conectar.
QUOTEX_PROXIES=

# Token gerado pelo @BotFather
TELEGRAM_BOT_TOKEN=cole-o-token-do-bot-aqui
# ID do grupo/canal (supergrupos e canais começam com -100). Use um grupo de TESTE primeiro.
TELEGRAM_CHAT_ID=-1000000000000

# Mercado e análise
# Pares analisados ao mesmo tempo (OTC funciona 24h). Um par inválido é ignorado com aviso no log.
ASSETS=EURUSD_otc,GBPUSD_otc,USDJPY_otc,AUDCAD_otc,EURJPY_otc,AUDUSD_otc,USDCAD_otc,USDCHF_otc,EURGBP_otc,GBPJPY_otc,AUDJPY_otc,NZDUSD_otc
PERIOD_SECONDS=60
CANDLES_OFFSET_SECONDS=7200
EXPIRY_MINUTES=2
POLL_SECONDS=5
MIN_CONFIDENCE=3
# true = no máximo uma entrada aberta por par
ONE_SIGNAL_AT_A_TIME=true
# Entradas abertas ao mesmo tempo somando todos os pares. 1 = próximo sinal só depois do resultado do anterior.
# Se vários pares sinalizarem juntos, vai só o de mais confirmações.
MAX_OPEN_ENTRIES=1
# Intervalo mínimo entre sinais, em minutos (0 = sem intervalo)
SIGNAL_COOLDOWN_MINUTES=0
# Estratégia: auto (recomendado) escolhe pelo tipo de mercado medido pelo ADX:
#   tendência forte -> tendencia (pullback na EMA 21 com candle de rejeição)
#   mercado lateral -> reversao (Bollinger + RSI extremo + rejeição; estocástico e suporte/resistência somam)
#   indefinido      -> não opera
# Outras opções: tendencia, reversao, classica (EMA 9/21 + RSI), classica_filtros
STRATEGY=auto
# Filtros opcionais da estratégia classica. Ligue só se o backtest (python -m src.backtest) mostrar que ajudam.
TREND_FILTER=false
MIN_VOLATILITY=0

# Sessões em horário de Brasília. Cada janela vira uma sessão com abertura e relatório final.
ALLOWED_WINDOWS=09:00-11:00,14:00-17:00

# Mensagens
SIGNAL_TITLE=SINAL GRÁTIS
# Opcionais: deixe vazio para não mostrar a linha
BROKER_LINK=
TUTORIAL_LINK=

# Imagens (opcionais; vazio = só texto)
IMG_START=assets/operacoes-iniciando.png
IMG_WIN=assets/win.png
IMG_END=assets/operacoes-encerradas.png

# Arquivos locais de auditoria
DATA_DIR=data
